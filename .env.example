# Copy to .env.local and fill in. Never commit real values.
# Use the anon / publishable key only. Never put the service_role key in a VITE_* variable.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-or-publishable-key>

# Development only: replace the admin API with in-memory sample data (the backend is not deployed yet).
#   on = sample projects and fields of every type, empty = no extra fields, not-ready = every call answers 501.
# Ignored by production builds. Leave unset to call the real backend.
# VITE_ADMIN_API_MOCK=on
